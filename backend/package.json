{
  "name": "simulacra-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "mock": "BRAIN=mock tsx src/server.ts",
    "test": "tsx --test --expose-gc --test-force-exit test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx src/bench.ts",
    "doctor": "tsx src/doctor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "esbuild": "^0.28.2",
    "three": "^0.187.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@iwer/sem": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "iwer": "^2.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "simulacra-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "mock": "BRAIN=mock tsx src/server.ts",
    "test": "tsx --test --expose-gc --test-force-exit test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx --env-file-if-exists=.env src/bench.ts",
    "doctor": "tsx --env-file-if-exists=.env src/doctor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

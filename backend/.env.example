# Copy to .env and fill in.

# --- Which mind drives the character
# claude   : Claude plans and picks skills; separate speech-to-text and text-to-speech (needs both keys below)
# realtime : one speech-to-speech model does everything (needs OPENAI_API_KEY only)
# mock     : keyword rules, typed text, no AI (wiring tests only)
# Unset = claude if ANTHROPIC_API_KEY is set, else realtime if OPENAI_API_KEY is set, else mock.
BRAIN=

# --- Claude (planning)
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5-5
# low keeps replies fast; raise only if decisions are poor.
PLANNER_EFFORT=low
# 1 = fast output mode (costs more; only on models that support it).
PLANNER_FAST=0
# off = send thinking disabled (only on models that accept it; rejected by claude-opus-5-5).
PLANNER_THINKING=

# --- OpenAI (ears, voice, camera detection; and the whole mind when BRAIN=realtime)
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
VISION_MODEL=gpt-4.1-mini

PORT=8787
# A bare "stop" halts the body locally before any model call. 0 disables.
STOP_REFLEX=1
# Seconds of silence before the companion may pick its own goal. 0 disables.
AUTONOMY_IDLE_SEC=0

# Easiest: run `npm start` and paste your keys at http://localhost:8787/setup (it writes this file for you).
# By hand: copy to .env, fill in the keys, then run: npm run doctor

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Everything below is optional.

# Which mind drives the character. Unset = realtime if OPENAI_API_KEY is set (falls back to gpt by itself
# if the live connection cannot open), else claude, else mock. realtime is by far the fastest.
#   claude   : Claude plans; OpenAI provides hearing, voice and camera detection
#   gpt      : an OpenAI chat model plans; OpenAI provides hearing, voice and camera detection (one key)
#   realtime : one OpenAI speech-to-speech model does everything
#   mock     : keyword rules and typed text, not AI (wiring tests only)
#BRAIN=claude

#PLANNER_MODEL=claude-opus-5-5
#PLANNER_EFFORT=low
#PLANNER_FAST=1          # faster output, higher price, only on models that support it
#OPENAI_PLANNER_MODEL=gpt-5.4-mini
#OPENAI_PLANNER_EFFORT=none   # empty for models without reasoning (e.g. gpt-4.1-mini)
#REALTIME_MODEL=gpt-realtime
#REALTIME_VOICE=marin
#REALTIME_SILENCE_MS=350     # pause that ends your turn; lower answers sooner, higher interrupts less
#STT_MODEL=gpt-4o-mini-transcribe
#TTS_MODEL=gpt-4o-mini-tts
#VISION_MODEL=gpt-4.1-mini
#PORT=8787

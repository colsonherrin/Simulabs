# Copy to .env and fill in.
OPENAI_API_KEY=
# realtime | mock   (mock needs no key: typed text + keyword rules, for wiring tests)
BRAIN=realtime
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
VISION_MODEL=gpt-4.1-mini
PORT=8787
# Seconds of silence before the companion may pick its own goal. 0 disables.
AUTONOMY_IDLE_SEC=0
